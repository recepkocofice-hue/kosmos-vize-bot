# ============================================================
# KOSMOS VISA BOT CONFIGURATION
# ============================================================
# Copy this file to .env and fill in your values

# ------------------------------------------------------------
# TELEGRAM CONFIGURATION
# ------------------------------------------------------------
# Get token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Get chat ID from @userinfobot on Telegram
TELEGRAM_CHAT_ID=your_chat_id_here

# ------------------------------------------------------------
# APPLICANT INFORMATION
# ------------------------------------------------------------
APPLICANT_FIRST_NAME=John
APPLICANT_LAST_NAME=Doe
APPLICANT_NATIONALITY_NUMBER=12345678901
APPLICANT_PASSPORT_NUMBER=U12345678
APPLICANT_BIRTH_DATE=1990-01-15
APPLICANT_EMAIL=john.doe@example.com
APPLICANT_PHONE=+905551234567

# ------------------------------------------------------------
# APPOINTMENT SETTINGS
# ------------------------------------------------------------
# Dealer/Location ID (1 = Istanbul)
DEALER_ID=1

# Application type: 1 = Individual, 2 = Family
APPLICATION_TYPE=1

# Appointment type: 16 = Standard, 18 = VIP, 2339 = EEA Spouse
APPOINTMENT_TYPE=16

# ------------------------------------------------------------
# MONITORING SETTINGS
# ------------------------------------------------------------
# How often to check for slots (seconds)
CHECK_INTERVAL=60

# How many days ahead to check
DAYS_TO_CHECK=30

# Minimum available quota to trigger notification
MIN_QUOTA=1

# ------------------------------------------------------------
# FILTERING (Optional)
# ------------------------------------------------------------
# Only check these dates (comma-separated, YYYY/MM/DD format)
# Leave empty to check all dates
PREFERRED_DATES=

# Only notify for these time ranges (comma-separated)
# Example: 09:00-12:00,14:00-17:00
PREFERRED_TIMES=

# Skip these dates (comma-separated)
EXCLUDED_DATES=

# ------------------------------------------------------------
# BOOKING SETTINGS
# ------------------------------------------------------------
# Automatically attempt booking when slot found
AUTO_BOOK=false

# Run browser in background (no visible window)
HEADLESS=false

# Timeout for CAPTCHA solving (seconds)
BOOKING_TIMEOUT=120
